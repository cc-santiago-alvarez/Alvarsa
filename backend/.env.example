# MongoDB connection (instancia existente)
MONGO_URI=mongodb://user:password@host:27017/?authSource=admin&directConnection=true
MONGO_DB=alvarsa

# HTTP server
HTTP_ADDR=:8080

# CORS: origen del frontend (fase 2)
CORS_ORIGIN=http://localhost:3000

# Sesiones
SESSION_TTL_HOURS=168
SESSION_COOKIE_NAME=alv_session
# En producción (HTTPS) poner true
COOKIE_SECURE=false

# Seed: credenciales del admin inicial
SEED_ADMIN_EMAIL=admin@alvarsa.com
SEED_ADMIN_PASSWORD=changeme

# Correo (Resend — https://resend.com). Sin RESEND_API_KEY el envío queda
# deshabilitado (mailer noop: solo registra en el log, no falla).
RESEND_API_KEY=
# Remitente: en producción, un dominio verificado en Resend.
# Para pruebas puedes usar el remitente sandbox: "Alvarsa <onboarding@resend.dev>"
MAIL_FROM=Alvarsa <onboarding@resend.dev>
# Destinatario de las notificaciones (el taller). Por defecto, SEED_ADMIN_EMAIL.
MAIL_TO=admin@alvarsa.com
